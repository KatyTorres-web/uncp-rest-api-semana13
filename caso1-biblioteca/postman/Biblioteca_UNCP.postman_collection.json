    {
      "name": "0. Autenticación",
      "item": [
        {
          "name": "Token admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"token_admin\", pm.response.json().token);",
                  "pm.test(\"Token recibido\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
